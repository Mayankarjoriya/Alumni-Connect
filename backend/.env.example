# Alumni Connect Backend Environment Configuration

# Database
DATABASE_URL=sqlite:///./alumni_connect.db

# JWT & Security
SECRET_KEY=alumni-connect-super-secret-key-change-in-production-2024
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT=60/minute
ENVIRONMENT=development

# ─── AI / LLM Profile Extraction (Optional) ───
# Option 1: OpenRouter (Has 100% Free models including DeepSeek R1 & Llama 3.3)
# Sign up at: https://openrouter.ai/keys
LLM_API_KEY=your_openrouter_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
# (Other free models on OpenRouter: meta-llama/llama-3.3-70b-instruct:free, google/gemini-2.0-flash-exp:free)

# Option 2: Hugging Face Serverless API (Free)
# Get token at: https://huggingface.co/settings/tokens
# LLM_API_KEY=hf_...
# LLM_BASE_URL=https://router.huggingface.co/hf-inference/v1
# LLM_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Option 3: DeepSeek Direct (Requires paid credits)
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

